# ==========================================
# AI STORY VIDEO GENERATION HARNESS CONFIG
# ==========================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security & Authentication
SECRET_KEY=generate-a-strong-random-key-here-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Harness2026!Secure

# Database
DATABASE_URL=sqlite+aiosqlite:///backend/data/harness.db

# Storage & Quotas
MIN_DISK_FREE_GB=3.0
MAX_CONCURRENT_JOBS=1
AUTO_CLEANUP_TEMP_FILES=true

# AI Providers
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

VISUAL_PROVIDER=ai_diffusion
COMFYUI_URL=http://127.0.0.1:8188

TTS_PROVIDER=piper
PIPER_VOICE_MODEL=en_US-lessac-medium
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=models/piper/en_US-lessac-medium.onnx.json

# Video Rendering Defaults (Vertical 9:16 Facebook Reels / Shorts)
DEFAULT_DURATION_SECONDS=45
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_WIDTH=720
DEFAULT_HEIGHT=1280
DEFAULT_FPS=24
DEFAULT_VIDEO_BITRATE=3000k
DEFAULT_AUDIO_BITRATE=192k
DEFAULT_STYLE=business_strategy
ENABLE_KEN_BURNS=true
ENABLE_SUBTITLES=true
ENABLE_BACKGROUND_MUSIC=true
BACKGROUND_MUSIC_VOLUME=0.12
ENABLE_TRANSITION_SFX=true
SFX_VOLUME=0.20

# Meta / Facebook Graph API Credentials
META_PAGE_ID=your_page_id_here
META_PAGE_ACCESS_TOKEN=your_page_access_token_here
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here
META_GRAPH_API_VERSION=v21.0

# Autonomous Scheduling & Facebook Publishing Agent
TIMEZONE=Asia/Dhaka
FACEBOOK_PUBLISHING_ENABLED=true
DRY_RUN=false
AUTOPILOT_ENABLED=true
AUTOPILOT_DAILY_TARGET=5
AUTOPILOT_INTERVAL_SECONDS=1800
DAILY_PUBLISH_SLOTS=["09:00", "12:00", "15:00", "18:00", "21:00"]
MAX_DAILY_PUBLISHED_VIDEOS=5
